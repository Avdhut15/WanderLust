<nav class="navbar navbar-expand-md bg-light sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <form class="navbar-search" action="/listings" method="get">
        <input
          type="search"
          name="search"
          value="<%= typeof filters !== 'undefined' ? filters.search : '' %>"
          placeholder="Search destinations"
          aria-label="Search destinations"
        />
        <button type="submit" title="Search destinations" aria-label="Search destinations">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <% if (typeof filters !== 'undefined' && filters.taxes) { %><input type="hidden" name="taxes" value="1" /><% } %>
      </form>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">List your place</a>
        <% if (currentUser) { %>
          <form action="/logout" method="POST" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="nav-link logout-button" type="submit">Log out</button>
          </form>
        <% } else { %>
          <a class="nav-link" href="/signup">Sign up</a>
          <a
            class="nav-link"
            href="/login?redirect=<%= encodeURIComponent(currentUrl) %>"
          >Log in</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
