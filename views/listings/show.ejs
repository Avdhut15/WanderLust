<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">
  <h2 class="fw-bold mb-4">Listing Details</h2>

  <div class="row g-5 align-items-start">
    <!-- Image -->
    <div class="col-lg-7">
      <img
        src="<%= listing.image.url %>"
        class="show-img"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Details -->
    <div class="col-lg-5">
      <h2 class="show-title"><%= listing.title %></h2>

      <p class="show-desc"><%= listing.description %></p>

      <hr />

      <h3 class="show-price">₹ <%= listing.price.toLocaleString("en-IN") %></h3>

      <p class="show-location mt-3">
        <i class="fa-solid fa-location-dot text-danger"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit">
          Edit
        </a>

        <form
          action="/listings/<%= listing._id %>?_method=DELETE"
          method="POST"
        >
          <button class="btn btn-delete">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>
