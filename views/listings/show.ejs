<% layout("/layouts/boilerplate") %>

<link
  href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css"
  rel="stylesheet"
/>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

<div class="container mt-4 mb-5">
  <h2 class="fw-bold mb-4"><%= listing.title %></h2>

  <div class="show-listing">
    <div class="show-image-wrap">
      <img
        src="<%= listing.image.url %>"
        class="show-img"
        alt="<%= listing.title %>"
      />
    </div>

    <div class="show-details">
      <p class="show-owner">
        Owned by
        <%= listing.owner ? listing.owner.username : "Unknown owner" %>
      </p>

      <p class="show-desc"><%= listing.description %></p>

      <hr />

      <h3 class="show-price">₹ <%= listing.price.toLocaleString("en-IN") %></h3>

      <p class="show-location mt-3">
        <i class="fa-solid fa-location-dot text-danger"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
        <div
          id="listing-map"
          class="listing-map"
          data-coordinates="<%= JSON.stringify(listing.geometry.coordinates) %>"
          data-title="<%= listing.title %>"
          data-location="<%= listing.location %>, <%= listing.country %>"
        ></div>
        <p class="form-text">Map location is approximate and based on the listed city.</p>
      <% } else { %>
        <p class="text-muted">Map location is not available for this listing yet.</p>
      <% } %>

      <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit">
            Edit
          </a>

          <form
            action="/listings/<%= listing._id %>?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-delete">Delete</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <% if (currentUser || listing.reviews.length > 0) { %>
    <section class="reviews-section">
    <% if (currentUser) { %>
      <div class="review-form-wrap">
        <h4>Leave a review</h4>
        <form
          action="/listings/<%= listing._id %>/reviews"
          method="post"
          novalidate
          class="needs-validation"
        >
          <div class="mb-3">
            <fieldset class="starability-basic">
              <legend>Rating</legend>
              <input
                type="radio"
                id="rating-no-rate"
                class="input-no-rate"
                name="review[rating]"
                value=""
                aria-label="No rating"
                checked
              />
              <input type="radio" id="rating-1" name="review[rating]" value="1" />
              <label for="rating-1" title="Terrible">1 star</label>
              <input type="radio" id="rating-2" name="review[rating]" value="2" />
              <label for="rating-2" title="Not good">2 stars</label>
              <input type="radio" id="rating-3" name="review[rating]" value="3" />
              <label for="rating-3" title="Average">3 stars</label>
              <input type="radio" id="rating-4" name="review[rating]" value="4" />
              <label for="rating-4" title="Very good">4 stars</label>
              <input type="radio" id="rating-5" name="review[rating]" value="5" />
              <label for="rating-5" title="Excellent">5 stars</label>
            </fieldset>
            <div class="invalid-feedback">Please choose a rating.</div>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea
              name="review[comment]"
              id="comment"
              rows="4"
              class="form-control"
              required
            ></textarea>
            <div class="invalid-feedback">Please enter a comment.</div>
          </div>
          <button class="btn btn-edit">Submit</button>
        </form>
      </div>
    <% } %>

    <% if (listing.reviews.length > 0) { %>
      <div class="reviews-list">
        <h4>Reviews</h4>
        <div class="row g-4">
          <% listing.reviews.forEach((review) => { %>
            <div class="col-md-6">
              <div class="card review-card h-100">
                <div class="card-body">
                  <div
                    class="starability-result"
                    aria-label="Rating: <%= review.rating %> out of 5"
                  >
                    <% for (let star = 1; star <= 5; star++) { %>
                      <span class="rating-star <%= star <= review.rating ? 'is-filled' : '' %>" aria-hidden="true">★</span>
                    <% } %>
                  </div>
                  <p class="card-text mt-2 mb-0">
                    Reviewed by <%= review.author ? review.author.username : "Unknown user" %>
                  </p>
                  <p class="card-text mt-3 mb-0"><%= review.comment %></p>
                  <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                    <form
                      action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                      method="POST"
                      class="mt-3"
                    >
                      <button class="btn btn-delete" type="submit">Delete Review</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
    </section>
  <% } %>
</div>

<script>
  const mapElement = document.querySelector("#listing-map");

  if (mapElement) {
    const coordinates = JSON.parse(mapElement.dataset.coordinates);
    const map = new maplibregl.Map({
      container: mapElement,
      style: "https://tiles.openfreemap.org/styles/bright",
      center: coordinates,
      zoom: 10.5,
    });

    const homeMarker = document.createElement("div");
    homeMarker.className = "home-map-marker";
    homeMarker.innerHTML = '<i class="fa-solid fa-house" aria-hidden="true"></i>';

    new maplibregl.Marker({ element: homeMarker, anchor: "bottom" })
      .setLngLat(coordinates)
      .setPopup(
        new maplibregl.Popup({ offset: 25 }).setHTML(
          `<strong>${mapElement.dataset.title}</strong><br>${mapElement.dataset.location}`
        )
      )
      .addTo(map)
      .togglePopup();

    map.addControl(new maplibregl.NavigationControl(), "top-right");
  }
</script>
