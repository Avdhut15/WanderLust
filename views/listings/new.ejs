<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-2">
    <h2 class="mb-4">Create a New Listing</h2>

    <form action="/listings" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          class="form-control"
          placeholder="Add a catchy title"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="3"
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Image Link</label>
        <input
          type="text"
          name="listing[image][url]"
          class="form-control"
          placeholder="Enter image URL/Link"
        />
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Price</label>
          <input
            name="listing[price]"
            class="form-control"
            placeholder="1200"
            required
          />
          <div class="invalid-feedback">Please enter a vilid price</div>
        </div>

        <div class="col-md-8 mb-3">
          <label class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            placeholder="India"
            required
          />
          <div class="invalid-feedback">Please enter Country name</div>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label">Location</label>
        <input
          type="text"
          name="listing[location]"
          class="form-control"
          placeholder="Jaipur, Rajasthan"
          required
        />
        <div class="invalid-feedback">Please enter location</div>
      </div>

      <button class="btn btn-danger add-btn">Add</button><br /><br />
    </form>
  </div>
</div>
